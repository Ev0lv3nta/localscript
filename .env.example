# Optional overrides for Docker Compose and local runtime scripts.
# The canonical path no longer requires copying this file.

LOCALSCRIPT_PORT=8080
LOCALSCRIPT_PROFILE=competition
LOCALSCRIPT_OLLAMA_MODE=remote_api
LOCALSCRIPT_OLLAMA_HOST=http://ollama:11434
# Для локального Compose разрешён только service alias `ollama`.
LOCALSCRIPT_ALLOW_REMOTE_OLLAMA=1
LOCALSCRIPT_OLLAMA_CONTAINER_ALIAS=ollama
LOCALSCRIPT_UI_ENABLED=0
LOCALSCRIPT_BIND_HOST=127.0.0.1
LOCALSCRIPT_REMOTE_MODE=0
# LOCALSCRIPT_REMOTE_TOKEN=replace-with-at-least-32-random-characters
LOCALSCRIPT_PRIMARY_MODEL=qwen3:8b-q4_K_M
LOCALSCRIPT_FALLBACK_MODEL=qwen3:4b-instruct-2507-q4_K_M
